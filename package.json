{
  "name": "iptvweb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @iptv/web dev",
    "dev:tv": "pnpm --filter @iptv/tv dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @iptv/e2e e2e",
    "dev:proxy": "cd apps/stream-proxy && node --env-file-if-exists=.env server.ts",
    "dev:mock": "node e2e/mock-iptv.mjs"
  },
  "engines": {
    "node": ">=20.19"
  }
}
