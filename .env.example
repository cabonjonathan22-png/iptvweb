# =============================================================================
#  apps/web  (dashboard + API)  ->  copier dans apps/web/.env.local en dev,
#  et dans les variables d'environnement du projet Vercel "web" en prod.
# =============================================================================

# URL publique du dashboard (utilisée pour le QR code de pairing et les liens).
NEXT_PUBLIC_APP_URL=https://app.mondomaine.com

# Origines autorisées à appeler l'API depuis la TV (CORS), séparées par des virgules.
TV_APP_ORIGINS=https://tv.mondomaine.com

# --- Base de données (Neon / Vercel Postgres) --------------------------------
# Laisser vide en dev local : une base PGlite est créée dans apps/web/.data/.
# En prod, utiliser l'URL "pooled" de Neon.
DATABASE_URL=

# --- Upstash Redis (optionnel) -----------------------------------------------
# Vide : codes de pairing et rate limiting stockés dans Postgres (prod) ou en
# mémoire (dev). Les noms KV_REST_API_URL / KV_REST_API_TOKEN sont aussi acceptés.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth.js -----------------------------------------------------------------
# Générer avec : npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
# Magic link par email via Resend. Vide en dev : le lien s'affiche dans la console.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Oria <connexion@mondomaine.com>"
# Google OAuth (optionnel). Redirect URI : https://app.mondomaine.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Chiffrement des identifiants Xtream (AES-256-GCM) -----------------------
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne JAMAIS changer en prod sans migration : les identifiants existants deviendraient illisibles.
CREDENTIALS_ENCRYPTION_KEY=

# --- Synchronisation des playlists -------------------------------------------
# Protège /api/cron/sync (Vercel l'envoie en "Authorization: Bearer") et les
# relances internes /api/sync/run. Obligatoire en prod : openssl rand -hex 32
CRON_SECRET=
# URL utilisée par le serveur pour se relancer lui-même entre deux morceaux de
# synchro. Par défaut NEXT_PUBLIC_APP_URL.
SYNC_BASE_URL=
# Temps de travail max par invocation (ms). Défaut 240000 (maxDuration 300 s).
SYNC_BUDGET_MS=
# Dev uniquement (ignoré sur Vercel) : autorise les sources sur le réseau local,
# ex. le faux serveur IPTV e2e/mock-iptv.mjs.
ALLOW_PRIVATE_SOURCES=

# --- Proxy de flux (apps/stream-proxy) ---------------------------------------
# URL publique du proxy, ex. https://stream.mondomaine.com (dev : http://localhost:8080).
# INDISPENSABLE en production : sans lui, les flux http:// sont bloqués sur la
# page HTTPS de la TV et les URL Xtream (avec identifiants) seraient envoyées
# telles quelles à la TV.
STREAM_PROXY_URL=
# Secret partagé avec le proxy (même valeur des deux côtés) : openssl rand -hex 32
STREAM_PROXY_SECRET=

# --- À partir des étapes suivantes -------------------------------------------
# Enrichissement des films/séries (optionnel).
TMDB_API_KEY=

# =============================================================================
#  apps/tv  (SPA TV)  ->  apps/tv/.env.local en dev, projet Vercel "tv" en prod.
# =============================================================================

# URL du dashboard/API appelée par la TV.
VITE_API_URL=https://app.mondomaine.com
