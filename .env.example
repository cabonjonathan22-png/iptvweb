# =============================================================================
#  apps/web  (dashboard + API)  ->  copier dans apps/web/.env.local en dev,
#  et dans les variables d'environnement du projet Vercel "web" en prod.
# =============================================================================

# URL publique du dashboard (utilisée pour le QR code de pairing et les liens).
NEXT_PUBLIC_APP_URL=https://app.mondomaine.com

# Origines autorisées à appeler l'API depuis la TV (CORS), séparées par des virgules.
TV_APP_ORIGINS=https://tv.mondomaine.com

# --- Base de données (Neon / Vercel Postgres) --------------------------------
# Laisser vide en dev local : une base PGlite est créée dans apps/web/.data/.
# En prod, utiliser l'URL "pooled" de Neon.
DATABASE_URL=

# --- Upstash Redis (codes de pairing + rate limiting) ------------------------
# Laisser vide en dev local : stockage en mémoire (un seul process).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth.js -----------------------------------------------------------------
# Générer avec : npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
# Magic link par email via Resend. Vide en dev : le lien s'affiche dans la console.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Oria <connexion@mondomaine.com>"
# Google OAuth (optionnel). Redirect URI : https://app.mondomaine.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Chiffrement des identifiants Xtream (AES-256-GCM) -----------------------
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne JAMAIS changer en prod sans migration : les identifiants existants deviendraient illisibles.
CREDENTIALS_ENCRYPTION_KEY=

# --- À partir des étapes suivantes -------------------------------------------
# URL publique du proxy de flux (apps/stream-proxy), ex. https://stream.mondomaine.com
STREAM_PROXY_URL=
# Secret partagé avec le proxy pour signer les URL de lecture.
STREAM_PROXY_SECRET=
# Enrichissement des films/séries (optionnel).
TMDB_API_KEY=
# Protège les routes Vercel Cron (Vercel l'envoie en "Authorization: Bearer").
CRON_SECRET=

# =============================================================================
#  apps/tv  (SPA TV)  ->  apps/tv/.env.local en dev, projet Vercel "tv" en prod.
# =============================================================================

# URL du dashboard/API appelée par la TV.
VITE_API_URL=https://app.mondomaine.com
